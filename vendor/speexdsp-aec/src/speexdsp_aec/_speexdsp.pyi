from collections.abc import Buffer
from typing import Final

SPEEXDSP_VERSION: Final[str]

class EchoCanceller:
    """One stream's SpeexDSP MDF echo canceller. Not reentrant: one call at a time."""

    def __init__(
        self, frame_size: int, filter_length: int, sample_rate: int, *, preprocess: bool = False
    ) -> None: ...
    def process(self, capture: Buffer, reference: Buffer, /) -> bytes:
        """One frame of capture and of reference (int16 samples or raw bytes, exactly
        ``frame_size`` samples each) in; the output frame as little-endian int16 bytes."""
    def reset(self) -> None: ...
    def close(self) -> None: ...
    @property
    def frame_size(self) -> int: ...
    @property
    def filter_length(self) -> int: ...
    @property
    def sample_rate(self) -> int: ...
    @property
    def preprocess(self) -> bool: ...
    @property
    def frames(self) -> int: ...
    @property
    def warnings(self) -> int: ...
    @property
    def closed(self) -> bool: ...
