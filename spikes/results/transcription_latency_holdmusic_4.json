d": null}, {"n": 29, "speech_t": 282.04, "commit_t": 285.6, "transcript": "开机以后一直显示正在加载。", "latency_ms": 221.4, "failed": null}, {"n": 30, "speech_t": 296.56, "commit_t": 298.9, "transcript": "好了，现在可以了。", "latency_ms": 206.9, "failed": null}]}}, "bot_rows": "spikes/results/transcription_latency_holdmusic_4.bots.jsonl"}