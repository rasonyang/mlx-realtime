# uv-managed environments and tool caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Large or downloaded artifacts (re-created by scripts; provenance in manifests)
spikes/data/
*.onnx
*.pcm
*.wav

# Build and test output
dist/
.coverage
.coverage.*
htmlcov/

# Logs, local secrets and editor state
*.log
.env
.env.*
.idea/
.vscode/
.claude/settings.local.json

.DS_Store

# ITU-T G.168 echo-path coefficients (© ITU, all rights reserved): never commit
**/g168*.json

# Build output of the vendored SpeexDSP extension (uv compiles vendor/speexdsp-aec on sync)
vendor/*/build/
vendor/**/*.so
*.egg-info/

# Per-leg partial results of resumable runs (spikes/transcription); the final JSON is committed
spikes/results/*.partial.jsonl
